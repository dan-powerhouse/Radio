  "cases": [
    {
      "name": "ok",
      "process": {
        "logline": "process@1",
        "id": "visa.tourist@1",
        "issuer": "Example Consulate (conformance fixture)",
        "accepts": {
          "did": "apply"
        },
        "requires": {
          "with.passport.number": "string",
          "with.passport.expiry": "date",
          "with.travel.arrival": "date",
          "with.travel.stay_days": "integer",
          "with.travel.purpose": "string",
          "with.travel.return_ticket": "boolean",
          "with.means.funds_usd": "number",
          "with.history.previous_overstay": "boolean"
        },
        "steps": [
          {
            "id": "passport_validity",
            "check": {
              ">=": [
                {
                  "days_between": [
                    {
                      "var": "with.travel.arrival"
                    },
                    {
                      "var": "with.passport.expiry"
                    }
                  ]
                },
                180
              ]
            },
            "if_not": "not",
            "reason": "The passport must be valid for 180 days after arrival."
          },
          {
            "id": "arrival_in_future",
            "check": {
              ">=": [
                {
                  "days_between": [
                    {
                      "var": "$today"
                    },
                    {
                      "var": "with.travel.arrival"
                    }
                  ]
                },
                1
              ]
            },
            "if_not": "not",
            "reason": "Arrival must be after the date of application."
          },
          {
            "id": "stay_limit",
            "check": {
              "<=": [
                {
                  "var": "with.travel.stay_days"
                },
                90
              ]
            },
            "if_not": "not",
            "reason": "A tourist stay cannot exceed 90 days."
          },
          {
            "id": "purpose",
            "check": {
              "in": [
                {
                  "var": "with.travel.purpose"
                },
                [
                  "tourism",
                  "family visit",
                  "business meeting"
                ]
              ]
            },
            "if_not": "not",
            "reason": "The purpose is not covered by a tourist visa."
          },
          {
            "id": "sufficient_funds",
            "check": {
              ">=": [
                {
                  "var": "with.means.funds_usd"
                },
                {
                  "*": [
                    {
                      "var": "with.travel.stay_days"
                    },
                    80
                  ]
                }
              ]
            },
            "if_not": "doubt",
            "reason": "Funds are below 80 USD per day of stay."
          },
          {
            "id": "return_ticket",
            "check": {
              "==": [
                {
                  "var": "with.travel.return_ticket"
                },
                true
              ]
            },
            "if_not": "doubt",
            "reason": "No return ticket was declared."
          },
          {
            "id": "no_previous_overstay",
            "check": {
              "==": [
                {
                  "var": "with.history.previous_overstay"
                },
                false
              ]
            },
            "if_not": "not",
            "reason": "A previous overstay was declared."
          }
        ],
        "grants": {
          "entries": "single",
          "valid_from": {
            "var": "with.travel.arrival"
          },
          "valid_until": {
            "add_days": [
              {
                "var": "with.travel.arrival"
              },
              90
            ]
          },
          "max_stay_days": {
            "var": "with.travel.stay_days"
          }
        },
        "if_ok": "Entry permitted within the granted window.",
        "if_doubt": "Referred to an officer. No entry permission yet.",
        "if_not": "Refused. The findings state why.",
