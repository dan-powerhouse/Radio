{
  "name": "@logline/receipt",
  "version": "0.1.0",
  "description": "LogLine Receipt v1: run a JSON tuple on a JSON process and get a signed, verifiable receipt.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/browser.js",
    "bin",
    "server",
    "SPEC.md",
    "VISION.md",
    "GLOSSARY.md",
    "DIPLOMACY.md",
    "contracts",
    "vectors",
    "processes",
    "examples",
    "supabase/README.md"
  ],
  "scripts": {
    "build": "tsc -p .",
    "vectors": "npm run build && node scripts/make-vectors.mjs",
    "test:node": "node scripts/stage-edge.mjs && node --test test/*.test.mjs",
    "test:bun": "bun test test/",
    "test:browser": "node scripts/browser-conformance.mjs",
    "test": "npm run build && npm run test:node && npm run test:bun && npm run test:browser",
    "example": "npm run build && node examples/course.mjs && node examples/trajectory.mjs",
    "serve": "npm run build && node bin/logline-server.mjs serve --publish processes",
    "zip": "node scripts/zip.mjs",
    "stage:edge": "npm run build && node scripts/stage-edge.mjs",
    "test:postgres": "npm run stage:edge && node test/postgres.integration.mjs",
    "test:mutations": "npm run build && node scripts/test-mutations.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "logline": "bin/logline.mjs",
    "logline-server": "bin/logline-server.mjs",
    "logline-diplomacy": "bin/diplomacy.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "playwright": "1.56.0",
    "supabase": "3.4.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "yaml": "2.9.1"
  }
}
